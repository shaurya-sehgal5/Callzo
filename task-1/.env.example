# Database connection
DATABASE_URL=postgresql+psycopg://callzo:callzo_dev_password@localhost:5433/callzo

# Webhook HMAC-SHA256 verification secret
WEBHOOK_SECRET=replace_with_a_secure_webhook_secret

# Bearer token for account API authentication
API_TOKEN=replace_with_a_secure_api_token

# Configurable development monthly cap (integer cents)
DEFAULT_MONTHLY_CAP_CENTS=1000

# Maximum event processing attempts before dead-lettering
MAX_EVENT_ATTEMPTS=5